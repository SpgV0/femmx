# Generated by test scripts (reproducible from the .py source)
# .txt reports are tracked as evidence; model/binary artifacts are not.
test/results/**/*.fem
test/results/**/*.ans
# The other three physics types' equivalents of .fem/.ans. Missed when
# the electrostatic/thermal/current-flow GPU solver tests were added --
# only magnetics' extensions (and electrostatic's .res) were ever listed,
# so those tests' outputs showed up as untracked and stayed that way.
test/results/**/*.fee
test/results/**/*.res
test/results/**/*.feh
test/results/**/*.anh
test/results/**/*.fec
test/results/**/*.anc
test/results/**/*.dxf
test/results/**/*.bmp
test/results/**/*.edge
test/results/**/*.ele
test/results/**/*.node
test/results/**/*.pbc
test/results/**/*.poly
# Artifacts of the coverage work of 2026-09: rendered PNGs, probe CSVs,
# generated Lua, deliberately-corrupted inputs and .femx caches. Same rule
# as above -- each is reproduced by re-running its .py, so only the report
# stays in the tree.
test/results/**/*.png
test/results/**/*.csv
test/results/**/*.lua
test/results/**/*.dat
test/results/**/*.femx
test/results/**/*.ansx
test/results/**/*.bak
test/results/**/*.stale
test/results/**/luavar_out.txt
test/results/**/junit.xml
__pycache__/
.pytest_cache/

# Scratch produced by examples/parallel_sweep.py
examples/sweep_work/

# ctest run-time scratch, written into the repo root by a bare `ctest`
# invoked from the top-level build tree.
Testing/
